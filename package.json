{
  "name": "sprocket-js",
  "version": "1.0.0",
  "license": "MIT",
  "source": "client_ts/src/sprocket.ts",
  "main": "client_ts/dist/sprocket.js",
  "types": "client_ts/dist/types.d.ts",
  "devDependencies": {
    "@parcel/packager-ts": "2.9.2",
    "@parcel/transformer-typescript-types": "2.9.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.4.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.0.1",
    "jest": "^29.5.0",
    "parcel": "^2.9.2",
    "process": "^0.11.10",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "scripts": {
    "server:build": "cd server && gleam build",
    "client:build": "cd client && gleam build --target javascript",
    "shared:test": "cd shared && gleam test --target javascript",
    "client_ts:build": "parcel build client_ts/src/sprocket.ts",
    "client_ts:test": "jest",
    "clean": "rm -rf build dist .parcel-cache priv/static/** client_ts/dist server/build client/build shared/build",
    "test": "cd server && gleam test && cd .. && yarn run shared:test && yarn run client_ts:test",
    "build": "yarn run server:build && yarn run client:build && yarn run client_ts:build"
  },
  "dependencies": {
    "reconnecting-websocket": "^4.4.0",
    "snabbdom": "^3.5.1",
    "topbar": "^2.0.1"
  }
}
